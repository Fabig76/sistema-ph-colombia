# 🔧 CONFIGURACIÓN DESARROLLO LOCAL - PH COLOMBIA
# Este archivo se puede versionar para desarrollo local

# 🌐 URLs del Backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_VERSION=v1

# 🖥️ URLs del Frontend  
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# 🔐 Configuración de Autenticación
NEXT_PUBLIC_JWT_EXPIRY=7d
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=30d

# 📱 Configuración SMS (para desarrollo - usar sandbox)
NEXT_PUBLIC_SMS_PROVIDER=twilio
NEXT_PUBLIC_SMS_SANDBOX_MODE=true

# 📊 Configuración de Logging
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# 🗄️ Configuración Base de Datos (solo para referencia)
# El frontend no se conecta directamente, pero útil para debugging
NEXT_PUBLIC_DB_HOST=localhost
NEXT_PUBLIC_DB_PORT=5432
NEXT_PUBLIC_DB_NAME=ph_colombia_db

# 🐳 Docker Configuration
NEXT_PUBLIC_DOCKER_MODE=true

# 🔧 Development Settings
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_MOCK_APIS=false

# 📄 Google Services (para paz y salvos)
NEXT_PUBLIC_GOOGLE_DOCS_ENABLED=true
NEXT_PUBLIC_GOOGLE_SHEETS_ENABLED=true

# ⚠️ IMPORTANTE: 
# - Este archivo AHORA se puede versionar para desarrollo
# - Para producción, crear .env.production.local (no versionado)
# - Variables sensibles van en archivos no versionados
