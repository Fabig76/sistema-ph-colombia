# 📋 PLANTILLA DE CONFIGURACIÓN - PH COLOMBIA FRONTEND
# Copia este archivo a .env.local y ajusta los valores según tu entorno

# 🌐 Backend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_VERSION=v1

# 🖥️ Frontend Configuration  
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3005
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# 🔐 Authentication
NEXT_PUBLIC_JWT_EXPIRY=7d
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=30d

# 📱 SMS Configuration
NEXT_PUBLIC_SMS_PROVIDER=twilio
NEXT_PUBLIC_SMS_SANDBOX_MODE=true

# 📊 Logging & Analytics
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# 🗄️ Database Reference (for debugging)
NEXT_PUBLIC_DB_HOST=localhost
NEXT_PUBLIC_DB_PORT=5432
NEXT_PUBLIC_DB_NAME=ph_colombia_db

# 🐳 Docker
NEXT_PUBLIC_DOCKER_MODE=true

# 🔧 Development
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_MOCK_APIS=false

# 📄 Google Services
NEXT_PUBLIC_GOOGLE_DOCS_ENABLED=true
NEXT_PUBLIC_GOOGLE_SHEETS_ENABLED=true

# 🔒 VARIABLES SENSIBLES (NO incluir aquí)
# Para variables sensibles crear archivo .env.production.local
# Ejemplos:
# GOOGLE_PRIVATE_KEY=...
# DATABASE_URL=...
# SMS_API_KEY=...
