# Variables de entorno para Docker
# Copiar este archivo a .env para desarrollo local con Docker

# Base de datos PostgreSQL
DATABASE_URL=postgresql://phuser:phpass123@postgres:5432/ph_colombia?schema=public

# Redis para caché
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
CACHE_TTL=3600

# JWT (Autenticación)
JWT_SECRET=tu_clave_super_secreta_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Google API (Reemplazar con tus credenciales)
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
GOOGLE_CLIENT_EMAIL=tu-servicio@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# SMS API (Reemplazar con tus credenciales)
SMS_API_URL=https://api.sms.com
SMS_API_KEY=tu_api_key_aqui
SMS_SENDER=PazySalvosPH
SMS_EXPIRY_SECONDS=300
SMS_MAX_ATTEMPTS=3

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SMS_WINDOW_MS=86400000
RATE_LIMIT_SMS_MAX=5

# Pagos Bold (Reemplazar con tus credenciales)
BOLD_API_URL=https://api.bold.co
BOLD_API_KEY=tu_api_key_aqui
BOLD_SECRET_KEY=tu_secret_key_aqui

# Logging
LOG_LEVEL=info
LOG_TO_DB=true

# Entorno
NODE_ENV=production
PORT=4000
