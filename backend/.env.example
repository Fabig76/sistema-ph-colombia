# Configuración de Base de Datos
DATABASE_URL="postgresql://phuser:phpass123@localhost:5432/ph_colombia"

# Configuración de JWT
JWT_SECRET="tu_clave_secreta_muy_segura_para_jwt"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Configuración de Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
CACHE_TTL="300" # 5 minutos en segundos

# Configuración de RabbitMQ
RABBITMQ_URL="amqp://phuser:phpass123@localhost:5672"

# Configuración del Servidor
PORT=3000
NODE_ENV="development"

# Configuración de Google API
GOOGLE_APPLICATION_CREDENTIALS="./config/google-credentials.json"
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Configuración de SMS (Hablame.co u otro proveedor)
SMS_API_KEY=""
SMS_API_URL=""
SMS_SENDER="PazySalvos"
SMS_EXPIRY_SECONDS="300" # 5 minutos
SMS_MAX_ATTEMPTS="3"

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS="900000" # 15 minutos
RATE_LIMIT_MAX="100" # 100 solicitudes por ventana
SMS_RATE_LIMIT_WINDOW_MS="3600000" # 1 hora
SMS_RATE_LIMIT_MAX="5" # 5 SMS por hora

# Configuración de Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT="10000" # 10 segundos
CIRCUIT_BREAKER_ERROR_THRESHOLD="50" # 50% de errores para abrir el circuito
CIRCUIT_BREAKER_RESET_TIMEOUT="30000" # 30 segundos para reintentar

# ===== CONFIGURACIÓN SISTEMA DE PAGOS =====
PAYMENT_PROVIDER="mock"
# PAYMENT_PROVIDER="bold" (cambiar cuando Bold esté listo)

# Bold API (para el futuro)
BOLD_API_KEY="pendiente"
BOLD_SECRET="pendiente"
BOLD_ENVIRONMENT="sandbox"
BOLD_WEBHOOK_URL="http://localhost:3000/api/payments/webhook/bold"

# Configuración pagos mock
MOCK_PAYMENT_SUCCESS_RATE="0.95"
MOCK_PAYMENT_DELAY_MIN="1000"
MOCK_PAYMENT_DELAY_MAX="3000"

# Configuración suscripciones
MONTHLY_SUBSCRIPTION_PRICE="20000"
TRIAL_PERIOD_DAYS="60"
SUBSCRIPTION_PERIOD_DAYS="30"
GRACE_PERIOD_DAYS="7"

# Configuración de Logs
LOG_LEVEL="info" # debug, info, warn, error
LOG_TO_DB="true"

